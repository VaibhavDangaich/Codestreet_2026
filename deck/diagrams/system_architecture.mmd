  W["Worker"]
  WF["ServicingCaseWorkflow<br/>saga · compensation · human approval"]
  NEO[("Neo4j Aura")]
  CY["Cytoscape analyst graph"]

  UI -->|HTTP| API
  API --> AG
  AG --> AUD
  API -->|start / signal / query| TS
  TS --> W
  W --> WF
  WF -->|do_action activity → /internal/action| API
  API -->|/graph| NEO
  NEO --> CY
  CY -.-> UI
