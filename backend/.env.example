OPENAI_API_KEY=sk-...
MODEL_NAME=gpt-4o-mini
CONFIDENCE_THRESHOLD=0.55

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=codestreet-servicing-agent

# Neo4j Aura (audit graph). For Aura, username/database are usually 'neo4j',
# but some instances use the instance id — check your Aura credentials file.
NEO4J_URI=neo4j+s://<instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
